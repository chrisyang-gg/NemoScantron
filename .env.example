# NVIDIA Nemotron — required for scoring and red-team generation
NVIDIA_API_KEY=
NVIDIA_NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1

# Anthropic Claude — required for ruleset training after a red-team round
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_API_BASE=https://api.anthropic.com

# Local app
NEMOSCANTRON_URL=http://127.0.0.1:43127
